# Symfony Application Example Configuration
# Copy this file to .env.local and update with your values

APP_ENV=dev
APP_SECRET=change-this-to-a-random-secret-key

# Database Configuration
DATABASE_URL=mysql://user:password@localhost:3307/database_name

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=your-jwt-passphrase

# CORS Configuration
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# API Platform Configuration
API_PLATFORM_TITLE="Your API Title"
API_PLATFORM_DESCRIPTION="Your API Description"
API_PLATFORM_VERSION=1.0.0

# Mailer Configuration (optional)
# MAILER_DSN=smtp://localhost:1025

# Rate Limiting
RATE_LIMITER_LOGIN_ATTEMPTS=5
RATE_LIMITER_LOGIN_INTERVAL="15 minutes"

# JWT Token Expiration
JWT_TOKEN_TTL=3600
JWT_REFRESH_TOKEN_TTL=2592000