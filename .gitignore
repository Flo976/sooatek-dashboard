# Project-wide ignores
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.local
.env.*
!.env.example
!backend/.env.example
!frontend/.env.example

# Backend (Symfony)
/backend/var/
!/backend/var/.gitkeep
/backend/vendor/
/backend/.env
/backend/.env.local
/backend/.env.test
/backend/.phpunit.result.cache
/backend/public/bundles/
/backend/.php-cs-fixer.cache
/backend/config/jwt/private.pem
/backend/config/jwt/public.pem

# Frontend (Next.js)
/frontend/node_modules/
/frontend/.next/
/frontend/out/
/frontend/coverage/
/frontend/.env.local
/frontend/.env.test
/frontend/.turbo/

# Root node modules
/node_modules/

# Docker artefacts
*.pid
.docker/cache

# Logs
*.log
