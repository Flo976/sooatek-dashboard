# Frontend Environment Configuration Example
# Copy this file to .env.local and update with your values

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1
NEXT_PUBLIC_APP_NAME=Sooatek Dashboard
NEXT_PUBLIC_APP_DESCRIPTION=Professional Dashboard Application

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-key-change-in-production

# API Endpoints
NEXT_PUBLIC_AUTH_API_URL=http://localhost:8001/api/auth
NEXT_PUBLIC_WS_URL=ws://localhost:8001

# Feature Flags (optional)
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG_MODE=true

# Environment
NODE_ENV=development

# Optional: External Services
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# NEXT_PUBLIC_SENTRY_DSN=

# JWT Configuration (should match backend)
JWT_SECRET=your-jwt-secret-key